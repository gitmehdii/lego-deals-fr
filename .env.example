# Copier en .env et remplir. Ne jamais committer le .env.

# SQLite en local, libSQL / Turso en production.
DATABASE_URL=sqlite:///local.db

# Clé API Brickset, utilisée pour le RRP. Sans elle, `catalog sync` importe
# l'identité des sets et saute la phase des prix.
BRICKSET_API_KEY=

# Webhook du salon Discord où partent les alertes (lot 5).
DISCORD_WEBHOOK_URL=

# Flux RSS d'alerte Dealabs configuré sur le mot-clé « lego » (lot 3).
DEALABS_RSS_URL=

# Sources du catalogue. Ce ne sont pas des secrets : elles sont ici parce
# qu'aucune URL externe n'est codée en dur, et que le jour où un fournisseur
# déplace un fichier, ça reste un changement de configuration.
REBRICKABLE_SETS_URL=https://cdn.rebrickable.com/media/downloads/sets.csv.gz
REBRICKABLE_THEMES_URL=https://cdn.rebrickable.com/media/downloads/themes.csv.gz
BRICKSET_API_URL=https://brickset.com/api/v3.asmx

# Seuil de remise déclenchant une alerte, en pourcentage (0-100).
MIN_DISCOUNT_PCT=25

# Score minimum de résolution pour associer une offre à un set (0-1).
MIN_RESOLUTION_SCORE=0.85

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
