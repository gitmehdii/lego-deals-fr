# Copier en .env et remplir. Ne jamais committer le .env.

# SQLite en local, libSQL / Turso en production. En production ce doit être
# Turso : le disque d'un runner GitHub est effacé entre deux exécutions, donc
# un fichier SQLite repartirait vide à chaque run.
#   sqlite:///local.db
#   sqlite+libsql://<base>.turso.io/?authToken=<token>&secure=true
#
# Les deux détails de la seconde ligne ne sont pas décoratifs :
#   - `sqlite+` : Turso donne `libsql://…`, SQLAlchemy n'a pas de dialecte
#     sous ce nom et échoue loin de la ligne fautive.
#   - `secure=true` : le pilote choisit http ou https d'après ce drapeau et le
#     met à false par défaut. Sans lui, le token part en clair.
# Les deux sont refusés au démarrage plutôt que silencieusement acceptés.
DATABASE_URL=sqlite:///local.db

# Clé API Brickset, utilisée pour le RRP. Sans elle, `catalog sync` importe
# l'identité des sets et saute la phase des prix.
BRICKSET_API_KEY=

# Webhook du salon Discord où partent les alertes et les avertissements de
# santé. À prendre dans Paramètres du salon → Intégrations → Webhooks, PAS le
# lien du salon (« Copier le lien ») qui est une page web, pas un endpoint.
#   https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# Flux RSS des offres. Par défaut le groupe LEGO public de Dealabs. Un flux
# d'alerte personnel configuré sur le mot-clé « lego » s'y substitue — mais
# cette URL-là contient un identifiant personnel, traite-la comme un secret.
DEALABS_RSS_URL=https://www.dealabs.com/rss/groupe/lego

# Sources du catalogue. Ce ne sont pas des secrets : elles sont ici parce
# qu'aucune URL externe n'est codée en dur, et que le jour où un fournisseur
# déplace un fichier, ça reste un changement de configuration.
REBRICKABLE_SETS_URL=https://cdn.rebrickable.com/media/downloads/sets.csv.gz
REBRICKABLE_THEMES_URL=https://cdn.rebrickable.com/media/downloads/themes.csv.gz
BRICKSET_API_URL=https://brickset.com/api/v3.asmx

# Seuil de remise déclenchant une alerte, en pourcentage (0-100).
MIN_DISCOUNT_PCT=25

# Score minimum de résolution pour associer une offre à un set (0-1).
MIN_RESOLUTION_SCORE=0.85

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
